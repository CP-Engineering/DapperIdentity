<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Without this no XML doc file is produced, so nothing written in /// ever reaches a
         consumer's IntelliSense. CS1591 stays a non-warning on purpose: documenting the surface
         is deliberate work, not something the compiler should force mid-refactor. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The namespaces carry the CPE. prefix (D-051) while the project file does not, so
         RootNamespace has to be stated - otherwise it defaults to the project name and every new
         file lands in the old namespace. -->
    <RootNamespace>CPE.DapperIdentity.Abstractions</RootNamespace>
  </PropertyGroup>

</Project>
