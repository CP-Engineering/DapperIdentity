<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Shipped as one of the five packages (D-053, superseding D-050's "not a package"): Blazor
         Server apps on cookie authentication need the Dapper stores without JwtBearer. Targets
         both runtimes like the other four, so a net10 host is not forced onto net8 assets. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The namespaces carry the CPE. prefix (D-051) while the project file does not, so
         RootNamespace has to be stated - otherwise it defaults to the project name and every new
         file lands in the old namespace. -->
    <RootNamespace>CPE.DapperIdentity.Cookies.Server</RootNamespace>
  </PropertyGroup>

  <!-- Version and shared metadata come from Directory.Build.props. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>CPE.DapperIdentity.Cookies.Server</PackageId>
    <Description>Cookie authentication for ASP.NET Core and Blazor Server apps on the CPE.DapperIdentity stores, with opt-in account and identity controllers. For JWT APIs use CPE.DapperIdentity.Jwt.Server instead.</Description>
    <PackageTags>identity;aspnetcore;blazor;cookies;authentication;dapper</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mvc.Core 2.3.9 and Mvc.ViewFeatures 2.3.9 removed 2026-09-13: ASP.NET Core *2.1* packages
         shadowing the shared framework (technical-spec 9o). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Newtonsoft.Json and System.Text.RegularExpressions 4.3.1 removed 2026-09-13: no usage
         anywhere in the repo. -->
    <!-- Microsoft.IdentityModel.JsonWebTokens removed 2026-09-14: nothing in this project mentions
         JsonWebToken, JwtSecurityToken, SecurityTokenDescriptor or SymmetricSecurityKey. A cookie
         scheme has no business carrying a JWT library.
         System.Text.Encodings.Web 9.0.4 removed 2026-09-19: its one user, the Basic auth handler
         in Helpers/, was deleted in Session 33h, and git grep finds no Encodings/HtmlEncoder/
         UrlEncoder use in this project. Packed, it would have been a dependency every consumer
         restores for nothing - and the shared framework supplies it anyway. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DapperIdentity.Stores\DapperIdentity.Stores.csproj" />
    <!-- The DapperIdentity ("vanilla") project is gone. Everything this project used from it -
         DapperIdentity.Services and DapperIdentity.Stores - now lives in DapperIdentity.Stores. -->
  </ItemGroup>

</Project>
