<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- The namespaces carry the CPE. prefix (D-051) while the project file does not, so
         RootNamespace has to be stated - otherwise it defaults to the project name and every new
         file lands in the old namespace. -->
    <RootNamespace>CPE.DapperIdentity.Jwt.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- ControllerBase, ApiController and IActionResult come from the shared framework, not from a
         package. Microsoft.AspNetCore.Mvc.Core 2.3.9 and Mvc.ViewFeatures 2.3.9 are ASP.NET Core
         *2.1* packages that shadow it - the same shape that produced CS1729 in Core
         (technical-spec 9o). Both still receive "latest" bumps, which reads as maintained and is
         not. Removed 2026-09-13. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Removed 2026-09-13, all four for a stated reason rather than tidiness:
       Newtonsoft.Json - its only trace was an orphan "using Newtonsoft.Json.Linq" in
         IClaimsService.cs, whose sole live member is an interface declaration.
       System.Text.RegularExpressions 4.3.1 - zero Regex usages anywhere in the repo.
       System.Formats.Asn1 and System.Security.Cryptography.Xml - the SDK reports both as
         NU1510 ("automatically available", supplied by the targeted framework), so the pins
         resolved to nothing. They were carried as CVE pins; the framework version now governs. -->

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- JwtBearer used to arrive transitively through the DapperIdentity ("vanilla") project.
         That reference is gone, so it is declared directly here where it is actually used
         (ServiceCollectionExtensions.cs AddJwtBearer). It is NOT in the shared framework. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.3" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.18.0" />
    <PackageReference Include="System.Text.Encodings.Web" Version="9.0.4" />
  </ItemGroup>

  <!-- Library pins are MINIMUMS, not latest - see the note in DapperIdentity.Jwt.Client.csproj. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <!-- Whatever floor the JwtBearer above forces through OpenIdConnect -> Tokens.Jwt; NU1605
         names it exactly if this is too low. The net8.0 leg keeps 8.18.0. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.18.0" />
    <PackageReference Include="System.Text.Encodings.Web" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DapperIdentity.Stores\DapperIdentity.Stores.csproj" />
    <ProjectReference Include="..\DapperIdentity.Abstractions\DapperIdentity.Abstractions.csproj" />
    <!-- The DapperIdentity ("vanilla") project reference is deliberately gone. It was carried for
         three classes - UserStore, RoleStore, CustomSignInManager - which now live in
         DapperIdentity.Stores, and it dragged Microsoft.AspNetCore.Identity.UI (a Bootstrap5 Razor
         Pages package), AddRazorSupportForMvc, Authentication.Cookies and Mvc.ViewFeatures into
         every API that consumes this library. -->
  </ItemGroup>

</Project>
